# AutoSpark 环境变量示例
#
# 注意：代码里没有调用 load_dotenv，这个文件不会被自动读取。
# 请用 systemd 的 EnvironmentFile=、docker 的 --env-file，或 shell 里 `set -a; . ./.env; set +a` 导入。
#
# 这里只列出代码中真正读取的变量（以前的版本列了几十个没人读的配置项，
# 改了也不生效，容易误导，已删掉）。留空 = 使用代码里的默认值。

# ============================================
# 通用
# ============================================

# 数据目录（状态文件 state.json、日志、失败截图都放这里），默认 ./data
SPARK_DATA_DIR=

# ============================================
# backend.py（FastAPI 主后端，默认端口 9844）
# ============================================

PORT=9844
SPARK_LOG_DIR=
CHROME_PROFILE_DIR=
CHROMEDRIVER_PATH=
CHROME_BINARY=
SPARK_USER_AGENT=

# 调度：随机偏移窗口 / 错过后补发宽限 / 失败重试间隔（分钟）
SPARK_JITTER_MINUTES=40
SPARK_CATCHUP_GRACE_MINUTES=360
SPARK_RETRY_AFTER_MINUTES=45

# 发送超时（秒）
SPARK_SEND_TIMEOUT=
SPARK_SEND_POLL=
SPARK_SEND_GRACE=
SPARK_IMAGE_SEND_TIMEOUT=

# 面板登录令牌有效期（小时），默认 72
SPARK_TOKEN_TTL_HOURS=72

# 启动时是否自动初始化浏览器（1=自动 / 0=手动点首页按钮），默认 1
SPARK_AUTO_INIT_BROWSER=1

# 1 = 显示 Chrome 窗口（扫码 / 短信 / 刷脸验证必须看得见），0 = 无头
SPARK_SHOW_BROWSER=1

# 浏览器互斥锁的等待预算（秒），默认 15；抢不到锁的请求直接返回 409
SPARK_LOCK_WAIT_SECONDS=15

# 主面板之外的额外允许跨域来源（逗号分隔），不要写 *
SPARK_CORS_ORIGINS=

# 只有部署在 nginx 等反向代理后面时才填代理 IP，否则客户端可以伪造 X-Forwarded-For。
# 默认只信任 127.0.0.1,::1；Docker 里要加 172.17.0.1。
SPARK_TRUSTED_PROXIES=
